---
import BaseLayout from '../layouts/BaseLayout.astro';
import StructuredData from '../components/StructuredData.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { withBase } from '../lib/url';
import { SITE } from '../consts';
import { formatDate, t } from '../i18n';

const works = (await getCollection('works'))
  .sort((a, b) => {
    const byDate = b.data.publishDate.getTime() - a.data.publishDate.getTime();
    return byDate || (a.data.order ?? 999) - (b.data.order ?? 999);
  })
  .slice(0, 3);

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 3);

const site = Astro.site ?? new URL(Astro.url.origin);
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.title,
  description: SITE.description,
  url: new URL(withBase('/'), site).href,
};

const featuredWork = works[0];
const featuredTags = ['Microsoft Foundry', 'Azure Container Apps', 'Terraform', 'Python', 'Azure SQL', 'AI Agents'];
---

<BaseLayout description={SITE.description}>
  <StructuredData slot="head" schema={websiteSchema} />

  <!-- Hero -->
  <section class="hero section">
    <p class="eyebrow">Joel Samaniego</p>
    <h1>I build AI solutions.</h1>
    <p class="lead">
      Cloud, agents and automation applied to real business problems.
    </p>
    <div class="action-row" aria-label="Primary links">
      <a class="button" href={withBase('/works/')}>View selected work</a>
      <a class="text-link" href="https://github.com/samajoel" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
      <a class="text-link" href="https://www.linkedin.com/in/joel-mateo-samaniego/" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
    </div>
  </section>

  <!-- Featured Work -->
  {featuredWork && (
    <section class="section" aria-labelledby="featured-work-heading" style="border-top: var(--hairline)">
      <div class="section-heading">
        <p class="eyebrow">Featured Work</p>
        <h2 id="featured-work-heading">Built and deployed.</h2>
        <a class="text-link" href={withBase('/works/')}>All work</a>
      </div>
      <div class="featured-work">
        <img
          class="featured-work-image"
          src={withBase('/images/azure-agentic-placeholder.svg')}
          alt="Architecture schematic for the Agentic Data Application — showing React frontend, FastAPI backend, AI agent, and Azure SQL components"
          width="720"
          height="480"
          loading="lazy"
        />
        <div class="featured-work-content">
          <span class="featured-work-status">Deployed · Live</span>
          <h3><a href={withBase(`/works/${featuredWork.id}/`)}>{featuredWork.data.title}</a></h3>
          <p>{featuredWork.data.description}</p>
          <ul class="tag-list" aria-label="Key technologies">
            {featuredTags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
          <div class="action-row" style="margin-top: var(--baseline)">
            <a class="button" href={withBase(`/works/${featuredWork.id}/`)}>View Case Study</a>
            {featuredWork.data.liveUrl && (
              <a
                class="text-link"
                href={featuredWork.data.liveUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                View Live Project ↗
              </a>
            )}
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Areas of Focus -->
  <section class="section split-overview" aria-label="Areas of focus">
    <div>
      <p class="eyebrow">Expertise</p>
      <h2>AI · Cloud · Automation</h2>
    </div>
    <div class="feature-list">
      <article>
        <h3>AI &amp; Agents</h3>
        <p>Building practical applications with generative AI, agents, LLMs and tool-based workflows.</p>
      </article>
      <article>
        <h3>Cloud Solutions</h3>
        <p>Deploying and integrating cloud-native services, infrastructure and data components.</p>
      </article>
      <article>
        <h3>Automation</h3>
        <p>Turning repetitive or operational problems into practical automated solutions.</p>
      </article>
    </div>
  </section>

  <!-- Technical Writing -->
  <section class="section index-feed" aria-labelledby="technical-writing">
    <div class="section-heading">
      <p class="eyebrow">Technical Writing</p>
      <h2 id="technical-writing">Deep dives.</h2>
      <a class="text-link" href={withBase('/blog/')}>All posts</a>
    </div>

    {
      posts.length > 0 ? (
        <div class="note-list">
          {posts.map((post) => (
            <article class="note-row">
              {post.data.heroImage && (
                <Image src={post.data.heroImage} alt="" width={320} height={220} loading="lazy" />
              )}
              <div>
                <p class="meta">{formatDate(post.data.publishDate, 'short')}</p>
                <h3>
                  <a href={withBase(`/blog/${post.id}/`)}>{post.data.title}</a>
                </h3>
                <p>{post.data.description}</p>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="empty-state compact">
          <p>Technical articles on AI, cloud infrastructure, and deployment are in progress.</p>
        </div>
      )
    }
  </section>

  <!-- About / Contact -->
  <section class="section prose-grid about-closing" aria-label="About and contact">
    <div>
      <p class="eyebrow">About</p>
      <h2>Problems, solutions, and shipping.</h2>
    </div>
    <div class="prose-stack">
      <p>
        I combine understanding of real problems with technical execution across AI, cloud, and
        automation — from requirement to deployment.
      </p>
      <div class="action-row">
        <a class="button" href={withBase('/about/')}>About</a>
        <a class="text-link" href="https://www.linkedin.com/in/joel-mateo-samaniego/" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
        <a class="text-link" href="mailto:samajoel@icloud.com">Email</a>
      </div>
    </div>
  </section>
</BaseLayout>
