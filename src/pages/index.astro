---
import BaseLayout from '../layouts/BaseLayout.astro';
import StructuredData from '../components/StructuredData.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { withBase } from '../lib/url';
import { SITE } from '../consts';
import { formatDate, t } from '../i18n';

const works = (await getCollection('works'))
  .sort((a, b) => {
    const byDate = b.data.publishDate.getTime() - a.data.publishDate.getTime();
    return byDate || (a.data.order ?? 999) - (b.data.order ?? 999);
  })
  .slice(0, 3);

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 3);

const site = Astro.site ?? new URL(Astro.url.origin);
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.title,
  description: SITE.description,
  url: new URL(withBase('/'), site).href,
};

const featuredWork = works[0];
const featuredTags = ['Microsoft Foundry', 'Azure Container Apps', 'Terraform', 'Python', 'Azure SQL', 'AI Agents'];
---

<BaseLayout description={SITE.description}>
  <StructuredData slot="head" schema={websiteSchema} />

  <!-- Hero -->
  <section class="hero section">
    <p class="eyebrow">Joel Samaniego</p>
    <h1>AI-Focused Product Builder</h1>
    <p class="lead">
      Cloud, agents and automation applied to real business problems.
    </p>
    <div class="action-row" aria-label="Primary links">
      <a class="button" href={withBase('/works/')}>View selected work</a>
      <a class="text-link" href="https://github.com/samajoel" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
      <a class="text-link" href="https://www.linkedin.com/in/joel-mateo-samaniego/" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
    </div>
  </section>

  <!-- Featured Work -->
  {featuredWork && (
    <section class="section" aria-labelledby="featured-work-heading" style="border-top: var(--hairline)">
      <div class="section-heading">
        <p class="eyebrow">Featured Work</p>
        <h2 id="featured-work-heading">Built and deployed.</h2>
        <a class="text-link" href={withBase('/works/')}>All work</a>
      </div>
      <div class="featured-work">
        <img
          class="featured-work-image"
          src={withBase('/images/azure-agentic-placeholder.svg')}
          alt="Architecture schematic for the Agentic Data Application — showing React frontend, FastAPI backend, AI agent, and Azure SQL components"
          width="720"
          height="480"
          loading="lazy"
        />
        <div class="featured-work-content">
          <span class="featured-work-status">Deployed · Live</span>
          <h3><a href={withBase(`/works/${featuredWork.id}/`)}>{featuredWork.data.title}</a></h3>
          <p>{featuredWork.data.description}</p>
          <ul class="tag-list" aria-label="Key technologies">
            {featuredTags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
          <div class="action-row" style="margin-top: var(--baseline)">
            <a class="button" href={withBase(`/works/${featuredWork.id}/`)}>View Case Study</a>
            {featuredWork.data.liveUrl && (
              <a
                class="text-link"
                href={featuredWork.data.liveUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                View Live Project ↗
              </a>
            )}
          </div>
        </div>
      </div>
    </section>
  )}

<!-- Areas of Focus -->

<section class="section split-overview" aria-label="Areas of focus">
  <div>
    <p class="eyebrow">Areas of Focus</p>
    <h2>Product · AI · Stakeholder Alignment</h2>
  </div>

  <div class="feature-list">
    <article>
      <h3>Product & Delivery</h3>
      <p>
        Turning business needs into clear requirements, practical solutions and
        deliverable MVPs — from defining priorities to coordinating execution.
      </p>
    </article>

    <article>
      <h3>AI & Automation</h3>
      <p>
        Exploring and applying generative AI, agents and automation to improve
        workflows, reduce manual effort and solve real operational problems.
      </p>
    </article>

    <article>
      <h3>Stakeholder Alignment</h3>
      <p>
        Connecting business and technical teams, gathering requirements,
        managing priorities and aligning cross-functional stakeholders around
        outcomes and delivery.
      </p>
    </article>
  </div>
</section>



<!-- About / Contact -->
<section class="section prose-grid about-closing" aria-label="About and contact">
  <div>
    <p class="eyebrow">About</p>
    <h2>From ambiguity to something that ships.</h2>
  </div>

  <div class="prose-stack">
    <p>
      I work across product, stakeholders, and technology to turn business needs
      into clear decisions, buildable solutions, and delivered outcomes — with a
      growing focus on AI, automation, and cloud.
    </p>

    <div class="action-row">
      <a class="button" href={withBase('/about/')}>More about me</a>

      <a
        class="text-link"
        href="https://www.linkedin.com/in/joel-mateo-samaniego/"
        target="_blank"
        rel="noopener noreferrer"
      >
        LinkedIn ↗
      </a>

      <a class="text-link" href="mailto:samajoel@icloud.com">
        Email
      </a>
    </div>
  </div>
</section>
</BaseLayout>
