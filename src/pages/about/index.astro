---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../consts';
import { t } from '../../i18n';
---

<BaseLayout
  title={t('about.title')}
  description="AI solutions builder working at the intersection of cloud, automation, and AI."
>
  <!-- Introduction -->
  <section class="page-head section">
    <p class="eyebrow">Joel Samaniego</p>
    <h1>AI solutions builder working at the intersection of cloud, automation, and AI.</h1>
    <p class="lead">
      Building practical, deployable solutions from real business problems.
    </p>
  </section>

  <!-- What I Focus On -->
  <section class="section prose-grid">
    <div>
      <p class="eyebrow">Focus</p>
      <h2>What I build.</h2>
    </div>
    <div class="prose-stack">
      <p>
        I build with generative AI and agentic applications — connecting LLMs, tools, and
        orchestration layers to real data and workflows. My focus is on solutions that are
        actually useful, not demos that stop at a proof of concept.
      </p>
      <p>
        On the cloud side: Azure deployment, infrastructure as code with Terraform, Container
        Apps, Managed Identity, and the integration work that connects everything together.
        Automation, APIs, and practical digital solutions round out the stack.
      </p>
    </div>
  </section>

  <!-- How I Work -->
  <section class="section split-overview" aria-label="Process">
    <div>
      <p class="eyebrow">Process</p>
      <h2>How I work.</h2>
    </div>
    <div class="feature-list">
      <article>
        <h3>Understand → Define</h3>
        <p>Start with the business or operational problem before choosing a technology.</p>
      </article>
      <article>
        <h3>Build → Deploy</h3>
        <p>Implement and configure end-to-end — infrastructure, services, integrations, and data.</p>
      </article>
      <article>
        <h3>Troubleshoot → Validate</h3>
        <p>Work through real constraints, adapt when the environment pushes back, confirm it works.</p>
      </article>
    </div>
  </section>

  <!-- Current Interests -->
  <section class="section prose-grid">
    <div>
      <p class="eyebrow">Now</p>
      <h2>Current interests.</h2>
    </div>
    <div class="prose-stack">
      <p>
        Agentic AI applications — specifically how to connect language models to structured
        enterprise data through tool-based architectures. Azure cloud architecture, infrastructure
        automation with Terraform, and the full deployment engineering that ships working systems
        into real environments.
      </p>
    </div>
  </section>

  <!-- Contact -->
  <section class="section" aria-label={t('about.ledgerLabel')}>
    <div class="about-ledger">
      <article>
        <h3>GitHub</h3>
        <p>
          <a href="https://github.com/samajoel" target="_blank" rel="noopener noreferrer">
            github.com/samajoel ↗
          </a>
        </p>
      </article>
      <article>
        <h3>LinkedIn</h3>
        <p>
          <a
            href="https://www.linkedin.com/in/joel-mateo-samaniego/"
            target="_blank"
            rel="noopener noreferrer"
          >
            linkedin.com/in/joel-mateo-samaniego ↗
          </a>
        </p>
      </article>
      <article>
        <h3>Email</h3>
        <p>
          <a href="mailto:samajoel@icloud.com">samajoel@icloud.com</a>
        </p>
      </article>
    </div>
  </section>
</BaseLayout>
