---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../consts';
import { t } from '../../i18n';
---

<BaseLayout
  title={t('about.title')}
  description="AI solutions builder working at the intersection of cloud, automation, and AI."
>
  <!-- Introduction -->
  <section class="page-head section">
    <p class="eyebrow">Joel Samaniego</p>
   <h1>Product-minded technologist transitioning into AI-focused product building.</h1>

<p class="lead">
  Turning business needs into working solutions through product thinking, automation, cloud, and hands-on technical execution.
</p>
  </section>

<!-- Vision -->
<section class="section prose-grid">
  <div>
    <p class="eyebrow">Vision</p>
    <h2>AI from infrastructure to impact.</h2>
  </div>

  <div class="prose-stack">
    <p>
      I believe AI will reshape how people work, make decisions, and interact with
      technology. What interests me most is not only the model itself, but the entire
      system around it, from cloud infrastructure and data to agents, applications,
      and the final product experience.
    </p>

    <p>
      I want to work across those layers, understanding how they connect and helping
      turn emerging AI capabilities into products that solve real problems and create
      meaningful value for people and businesses.
    </p>
  </div>
</section>

<!-- What I Bring -->
<section class="section split-overview" aria-label="What I bring">
  <div>
    <p class="eyebrow">What I Bring</p>
    <h2>Business context, product thinking, technical execution.</h2>
  </div>

  <div class="feature-list">
    <article>
      <h3>Product Thinking</h3>
      <p>
        Translating business needs into clear priorities, requirements, and practical
        solutions with a focus on user and business value.
      </p>
    </article>

    <article>
      <h3>Cross-functional Alignment</h3>
      <p>
        Connecting stakeholders, business teams, and technical contributors to create
        clarity, manage priorities, and move initiatives forward.
      </p>
    </article>

    <article>
      <h3>Hands-on Execution</h3>
      <p>
        Going beyond planning when needed, working with APIs, cloud services,
        automation, AI, and technical implementation to help turn ideas into working products.
      </p>
    </article>
  </div>
</section>


<!-- Current Focus -->
<section class="section prose-grid" aria-labelledby="current-focus-title">
  <div>
    <p class="eyebrow">Current Focus</p>
    <h2 id="current-focus-title">
      Product, AI, and the systems behind them.
    </h2>
  </div>

  <div class="prose-stack">
    <p>
      I’m focused on building AI-enabled products while understanding the full path
      from business needs and product decisions to agents, APIs, data, cloud infrastructure,
      deployment, and validation.
    </p>
  </div>
</section>

<!-- Skills Marquee -->
<section
  class="skills-marquee"
  aria-label="Current focus and technology stack"
>
  <!-- Accessible content for screen readers -->
  <ul class="visually-hidden">
    <li>Product</li>
    <li>Generative AI</li>
    <li>AI Agents</li>
    <li>Python</li>
    <li>Microsoft Azure</li>
    <li>APIs</li>
    <li>Terraform</li>
    <li>SQL</li>
    <li>Automation</li>
  </ul>

  <!-- Decorative marquee -->
  <div
    class="skills-track"
    aria-hidden="true"
    data-pagefind-ignore=""
  >
    <!-- GROUP 1 -->
    <div class="skills-group">

      <!-- Product -->
      <span class="skills-item">
        <img
          class="theme-icon"
          src="https://api.iconify.design/lucide:boxes.svg"
          alt=""
        />
        Product
      </span>

      <!-- Generative AI -->
      <span class="skills-item">
        <img
          class="theme-icon"
          src="https://api.iconify.design/lucide:sparkles.svg"
          alt=""
        />
        Generative AI
      </span>

      <!-- AI Agents -->
      <span class="skills-item">
        <img
          class="theme-icon"
          src="https://api.iconify.design/lucide:network.svg"
          alt=""
        />
        AI Agents
      </span>

      <!-- Python -->
      <span class="skills-item">
        <img
          src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/python/python-original.svg"
          alt=""
        />
        Python
      </span>

      <!-- Azure -->
      <span class="skills-item">
        <img
          src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/azure/azure-original.svg"
          alt=""
        />
        Microsoft Azure
      </span>

      <!-- APIs -->
      <span class="skills-item">
        <img
          class="theme-icon"
          src="https://api.iconify.design/lucide:braces.svg"
          alt=""
        />
        APIs
      </span>

      <!-- Terraform -->
      <span class="skills-item">
        <img
          src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/terraform/terraform-original.svg"
          alt=""
        />
        Terraform
      </span>

      <!-- SQL -->
      <span class="skills-item">
        <img
          class="theme-icon"
          src="https://api.iconify.design/lucide:database.svg"
          alt=""
        />
        SQL
      </span>

      <!-- Automation -->
      <span class="skills-item">
        <img
          class="theme-icon"
          src="https://api.iconify.design/lucide:workflow.svg"
          alt=""
        />
        Automation
      </span>

    </div>

    <!-- GROUP 2 - Duplicate for seamless infinite loop -->
    <div class="skills-group">

      <!-- Product -->
      <span class="skills-item">
        <img
          class="theme-icon"
          src="https://api.iconify.design/lucide:boxes.svg"
          alt=""
        />
        Product
      </span>

      <!-- Generative AI -->
      <span class="skills-item">
        <img
          class="theme-icon"
          src="https://api.iconify.design/lucide:sparkles.svg"
          alt=""
        />
        Generative AI
      </span>

      <!-- AI Agents -->
      <span class="skills-item">
        <img
          class="theme-icon"
          src="https://api.iconify.design/lucide:network.svg"
          alt=""
        />
        AI Agents
      </span>

      <!-- Python -->
      <span class="skills-item">
        <img
          src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/python/python-original.svg"
          alt=""
        />
        Python
      </span>

      <!-- Azure -->
      <span class="skills-item">
        <img
          src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/azure/azure-original.svg"
          alt=""
        />
        Microsoft Azure
      </span>

      <!-- APIs -->
      <span class="skills-item">
        <img
          class="theme-icon"
          src="https://api.iconify.design/lucide:braces.svg"
          alt=""
        />
        APIs
      </span>

      <!-- Terraform -->
      <span class="skills-item">
        <img
          src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/terraform/terraform-original.svg"
          alt=""
        />
        Terraform
      </span>

      <!-- SQL -->
      <span class="skills-item">
        <img
          class="theme-icon"
          src="https://api.iconify.design/lucide:database.svg"
          alt=""
        />
        SQL
      </span>

      <!-- Automation -->
      <span class="skills-item">
        <img
          class="theme-icon"
          src="https://api.iconify.design/lucide:workflow.svg"
          alt=""
        />
        Automation
      </span>

    </div>
  </div>
</section>


  <!-- Contact -->
  <section class="section" aria-label={t('about.ledgerLabel')}>
    <div class="about-ledger">
      <article>
        <h3>GitHub</h3>
        <p>
          <a href="https://github.com/samajoel" target="_blank" rel="noopener noreferrer">
            github.com/samajoel ↗
          </a>
        </p>
      </article>
      <article>
        <h3>LinkedIn</h3>
        <p>
          <a
            href="https://www.linkedin.com/in/joel-mateo-samaniego/"
            target="_blank"
            rel="noopener noreferrer"
          >
            linkedin.com/in/joel-mateo-samaniego ↗
          </a>
        </p>
      </article>
      <article>
        <h3>Email</h3>
        <p>
          <a href="mailto:samajoel@icloud.com">samajoel@icloud.com</a>
        </p>
      </article>
    </div>
  </section>
</BaseLayout>
